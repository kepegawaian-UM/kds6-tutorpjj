# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# Email service account (dari file JSON kunci, field "client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-akun@project-id.iam.gserviceaccount.com

# Private key (field "private_key" pada file JSON). Tulis dalam satu baris dengan tanda kutip,
# newline ditulis sebagai \n. Contoh: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=""

# ID spreadsheet: bagian di URL https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# Nama tab (default: Penugasan)
GOOGLE_SHEET_TAB=Penugasan

# Password untuk masuk ke aplikasi
APP_PASSWORD=

# String acak panjang (min. 32 karakter) untuk menandatangani cookie sesi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
